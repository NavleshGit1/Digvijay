# AirOps Nexus - Environment Configuration Template

# Operational Mode
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true
APP_SECRET_KEY=change-this-in-production-use-a-secure-random-key-at-least-32-chars

# PostgreSQL Database Configuration (with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airops_nexus
POSTGRES_USER=airops_user
POSTGRES_PASSWORD=airops_secure_password
DATABASE_URL=postgresql+psycopg://airops_user:airops_secure_password@localhost:5432/airops_nexus

# Redis Cache, Locks & Celery Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=airops_minio_admin
MINIO_SECRET_KEY=airops_minio_secure_key
MINIO_BUCKET_NAME=airops-artifacts
MINIO_SECURE=false

# JWT Authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Virtual System Clock Defaults
DEFAULT_CLOCK_MODE=system
DEFAULT_DEMO_AS_OF=2026-10-19T12:00:00Z

# Demo User Credentials (Seeded on first startup)
DEMO_PLANNER_USER=planner@airops.local
DEMO_PLANNER_PASSWORD=PlannerSecurePass2026!
DEMO_REVIEWER_USER=reviewer@airops.local
DEMO_REVIEWER_PASSWORD=ReviewerSecurePass2026!
DEMO_ANALYST_USER=analyst@airops.local
DEMO_ANALYST_PASSWORD=AnalystSecurePass2026!
DEMO_ADMIN_USER=admin@airops.local
DEMO_ADMIN_PASSWORD=AdminSecurePass2026!
